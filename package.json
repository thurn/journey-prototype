{
  "name": "journeys",
  "type": "module",
  "private": true,
  "bin": {
    "journey": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/cli.js",
    "journey": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:audit": "JOURNEY_SLOW_TESTS=1 JOURNEY_DIVERSITY_AUDIT=1 vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
